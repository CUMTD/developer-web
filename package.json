{
	"author": "MTD",
	"bugs": {
		"url": "https://github.com/CUMTD/developer-web/issues"
	},
	"contributors": [
		{
			"name": "Ryan Blackman",
			"url": "https://github.com/rblackman"
		},
		{
			"name": "Matt Novelli",
			"url": "https://github.com/mattnovelli"
		}
	],
	"description": "Monorepo for MTD Developer API docs site and NPM packages",
	"devDependencies": {
		"@biomejs/biome": "2.4.16",
		"@changesets/cli": "^2.31.0",
		"@commitlint/cli": "^21.0.2",
		"@commitlint/config-conventional": "^21.0.2",
		"@types/node": "^25.9.1",
		"cross-env": "^10.1.0",
		"dotenv": "^17.4.2",
		"dotenv-cli": "^11.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.7",
		"supabase": "^2.104.0",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3"
	},
	"engines": {
		"node": "v22.x"
	},
	"homepage": "https://mtd.dev/",
	"license": "Apache-2.0",
	"name": "@mtd.org/developer-web-monorepo",
	"packageManager": "pnpm@11.7.0+sha512.19cc852c120c7125760f2443ee6be0ca5b40f9f50598de1a09a1f177503e010e57c23c77646e01e761de59bf874fb22a3398c33ab9691fc13eb946b6f0f4d620",
	"private": true,
	"repository": {
		"type": "github",
		"url": "https://github.com/CUMTD/developer-web"
	},
	"scripts": {
		"build": "pnpm -r --workspace-concurrency=1 --sort build",
		"changeset": "changeset",
		"changeset:version": "changeset version && pnpm install --lockfile-only",
		"check": "biome check .",
		"check:fix": "biome check . --write",
		"ci:verify": "pnpm check && pnpm typecheck",
		"clean": "pnpm -r clean",
		"dev": "pnpm -r dev",
		"format": "biome format .",
		"format:fix": "biome format . --write",
		"gen": "pnpm -r gen",
		"lint": "biome lint .",
		"lint:fix": "biome lint . --write",
		"prebuild": "pnpm run gen",
		"preinstall": "corepack enable",
		"prepare": "husky",
		"release": "pnpm build && unset NODE_AUTH_TOKEN && unset NPM_CONFIG_USERCONFIG && changeset publish",
		"start": "pnpm -r start",
		"typecheck": "pnpm -r typecheck",
		"typegen": "pnpm -r typegen"
	},
	"type": "module",
	"version": "3.0.0"
}
