	"description": "Open API Spec for MTD Developer API",
	"devDependencies": {
		"@changesets/cli": "^2.31.0",
		"@commitlint/config-conventional": "^21.0.2",
		"@types/node": "^25.9.1",
		"dotenv": "^17.4.2",
		"lint-staged": "^17.0.7",
		"supabase": "^2.104.0",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3"
	},
	"exports": {
		"./openapi.json": "./dist/openapi.json",
		"./openapi.yml": "./dist/openapi.yml",
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"license": "Apache-2.0",
	"name": "@mtd.org/developer-api-spec",
	"private": false,
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"repository": {
		"directory": "packages/spec",
		"type": "git",
		"url": "https://github.com/CUMTD/developer-web"
	},
	"scripts": {
		"build": "pnpm exec tsx ../../scripts/check-spec-exists.ts",
		"clean": "pnpm exec tsx ../../scripts/clean dist",
		"gen": "pnpm exec tsx ../../scripts/check-spec-exists.ts --silent || dotenv -e ../../.env -- pnpm -C ../../tools gen:spec",
		"gen:force": "pnpm run clean && dotenv -e ../../.env -- pnpm -C ../../tools gen:spec"
	},
	"type": "module",
	"version": "3.0.1"
}
